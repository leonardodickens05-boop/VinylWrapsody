# Copy to .env (local) or set these in your host's environment settings (Netlify: Site settings -> Environment variables)

# Email delivery (https://resend.com – free tier, verify the vinylwrapsody.com domain then use a from-address on it)
RESEND_API_KEY=
LEAD_TO_EMAIL=info@vinylwrapsody.com
LEAD_FROM_EMAIL=Vinyl Wrapsody Website <quotes@vinylwrapsody.com>

# Optional extras
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxx/yyy   # copy every lead to a Google Sheet / CRM
# SEND_AUTOREPLY=false                                             # turn off the customer confirmation email
# PORT=8080                                                        # server.js only
